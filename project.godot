; Engine configuration file.
config_version=5

[application]

config/name="Untitled Survival"
config/description="Procedural first-person survival: explore by day, survive the night."
config/version="0.4.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
boot_splash/bg_color=Color(0.05, 0.07, 0.15, 1)
boot_splash/image="res://splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"

[autoload]

Settings="*res://scripts/core/settings.gd"
Audio="*res://scripts/audio/audio_manager.gd"
Game="*res://scripts/core/game.gd"
Music="*res://scripts/audio/music.gd"
Net="*res://scripts/net/net.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[rendering]

anti_aliasing/quality/msaa_3d=2

[physics]

common/physics_ticks_per_second=60
