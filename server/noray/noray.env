# Settings for the game's noray server. See https://github.com/foxssake/noray/blob/main/.env.example for all of them.

# Invite codes: 9 characters from the game's own alphabet (no 0/O/1/I), so they read like "KQ7M-B3XAP".
# The game expects exactly these two values.
NORAY_OID_LENGTH=9
NORAY_OID_CHARSET=ABCDEFGHJKLMNPQRSTUVWXYZ23456789

# Where players connect (TCP) and where games register their address (UDP). Open both in the firewall.
NORAY_SOCKET_HOST=0.0.0.0
NORAY_SOCKET_PORT=8890
NORAY_UDP_REGISTRAR_PORT=8809

# Metrics page (keep it private: only listens on the server itself).
NORAY_HTTP_HOST=127.0.0.1
NORAY_HTTP_PORT=8891

# Relay slots: one UDP port per relayed player. 200 is plenty for a demo; open this range (UDP) in the firewall.
NORAY_UDP_RELAY_PORTS=49152-49351
NORAY_UDP_RELAY_TIMEOUT=30s
# Per-player bandwidth through the relay (bytes/s). The game uses well under this.
NORAY_UDP_RELAY_MAX_INDIVIDUAL_TRAFFIC=128kb
